# Vorlage: nach .env kopieren und Werte setzen. .env wird NIE committet.
# Alle Anwendungs-Variablen tragen das Praefix AUTOMATO_ (pydantic-settings).

# --- docker-compose ---------------------------------------------------------
POSTGRES_PASSWORD=automato

# --- Orchestrator / Collectors ----------------------------------------------
# dev | staging | prod - ausserhalb "dev" wird der Default-Token abgelehnt (ADR 0005)
AUTOMATO_ENVIRONMENT=dev
AUTOMATO_DATABASE_URL=postgresql+psycopg://automato:automato@localhost:5432/automato
AUTOMATO_REDIS_URL=redis://localhost:6379/0
AUTOMATO_ORCHESTRATOR_URL=http://localhost:8000
# Service-Token Collector -> Orchestrator (interne API). In echten Umgebungen
# einen langen Zufallswert setzen, z. B.: openssl rand -hex 32
AUTOMATO_INTERNAL_API_TOKEN=dev-only-token
# Schluessel fuer die Geraete-Zugangsdaten (API-Tokens der Quellsysteme, ADR 0009).
# Leer = Schluesseldatei /var/lib/automato/credentials.key (Volume orchestrator-data, wird
# beim ersten Start erzeugt - mitsichern!). Alternativ eine lange Passphrase oder eine
# Secret-Referenz (openbao:/file:/env:). Wechsel/Verlust = Tokens im Web-UI neu hinterlegen.
# AUTOMATO_CREDENTIALS_KEY=
# Erlaubte CORS-Origins fuers Web-UI (JSON-Liste). In Produktion explizit setzen.
AUTOMATO_CORS_ORIGINS=["http://localhost:5173"]
# Die oeffentliche Read-API hat noch kein AuthN/RBAC. Ausserhalb "dev" verweigert der
# Start, bis dies bewusst gesetzt ist (nur mit Netzsegmentierung/Proxy-Auth davor).
AUTOMATO_ALLOW_UNAUTHENTICATED_READ_API=false

# --- AuthN/RBAC (E1, ADR 0007) ----------------------------------------------
# dev: Standard-Admin-Principal (unveraendertes Verhalten), Override zum Testen via
# Header X-Dev-Roles / X-Dev-Tenants. oidc: JWT gegen Keycloak (naechster Schritt E1.1b).
# Rollen: viewer|operator|admin; Mandanten-Scoping wird serverseitig erzwungen.
AUTOMATO_AUTH_MODE=dev
# AUTOMATO_OIDC_ISSUER=
# AUTOMATO_OIDC_AUDIENCE=
# AUTOMATO_OIDC_JWKS_URL=
# AUTOMATO_OIDC_ROLES_CLAIM=realm_access.roles
# AUTOMATO_OIDC_TENANTS_CLAIM=tenant_ids

# --- Source of Truth: NetBox (Model 2, lesend) -------------------------------
# NetBox laeuft als eigener Stack auf dem Host (source-of-truth/netbox/setup.sh,
# Port 8080). Aus den Automato-Containern via host.docker.internal erreichbar.
# Token = der READ-ONLY Collector-Token aus der setup.sh-Ausgabe.
AUTOMATO_NETBOX_URL=http://host.docker.internal:8080
AUTOMATO_NETBOX_TOKEN=
AUTOMATO_NETBOX_VERIFY_TLS=false

# --- Zielsysteme lokal (nur Rueckfall, read-only Accounts!) ------------------
# Normalfall: Adresse + Zugangsdaten am Quellsystem im Web-UI (ADR 0009). Diese Werte
# nutzt nur der zentrale Worker, wenn am Geraet nichts hinterlegt ist; beides leer ->
# Beispieldaten (Fixtures). verify_tls im Lab meist false (selbstsigniert).
AUTOMATO_FORTIGATE_URL=
AUTOMATO_FORTIGATE_TOKEN=
AUTOMATO_FORTIGATE_VERIFY_TLS=false
# Cisco APIC (Benutzer mit Nur-Lese-Rolle); ACI_TENANTS kommagetrennt, leer = alle
# ausser infra/mgmt
# AUTOMATO_ACI_URL=
# AUTOMATO_ACI_USERNAME=
# AUTOMATO_ACI_PASSWORD=
# AUTOMATO_ACI_VERIFY_TLS=false
# AUTOMATO_ACI_TENANTS=

# --- Weitere Zielsysteme (spaetere Phasen) -----------------------------------
# AUTOMATO_INFOBLOX_URL=
# AUTOMATO_INFOBLOX_USERNAME=
# AUTOMATO_INFOBLOX_PASSWORD=
