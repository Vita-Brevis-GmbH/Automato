# Vorlage: nach .env kopieren und Werte setzen. .env wird NIE committet.
# Alle Anwendungs-Variablen tragen das Praefix AUTOMATO_ (pydantic-settings).

# --- docker-compose ---------------------------------------------------------
POSTGRES_PASSWORD=automato
# Getrennte DB-Rollen (0.48.0): der Dienst migrate arbeitet als Eigentuemer "automato", der
# Orchestrator mit dieser Rolle ohne DDL. Einrichten mit `deploy/aufbau.sh db-rollen` (traegt
# beides mit Zufalls-Passwort ein); leer = Orchestrator als Eigentuemer (wie bis 0.47).
# AUTOMATO_DB_USER=automato_app
# AUTOMATO_DB_PASSWORD=
# TLS intern (0.49.0, ADR 0023): on = Postgres/Redis nur mit TLS, Orchestrator und Web-UI per
# HTTPS, alles gegen die eigene CA geprueft. Einrichten mit `deploy/aufbau.sh tls-intern`
# (stellt die Zertifikate in deploy/tls/pki aus und setzt den Schalter).
# AUTOMATO_INTERNAL_TLS=on
# mTLS-Agent-Gateway (Profil agent-gateway, deploy/agent-gateway): Name im Server-Zertifikat,
# Port auf der VM (1.5.1, Vorgabe 8443) - beides auch Vorgabe der agent.env in der Einrichtung.
# AUTOMATO_AGENT_GATEWAY_HOST=automato.example.ch
# AUTOMATO_AGENT_GATEWAY_PORT=8443
# AUTOMATO_AGENT_GATEWAY_SECRET=
# AUTOMATO_INTERNAL_MTLS_MODE=bind

# --- Orchestrator / Collectors ----------------------------------------------
# dev | staging | prod - ausserhalb "dev" wird der Default-Token abgelehnt (ADR 0005)
AUTOMATO_ENVIRONMENT=dev
AUTOMATO_DATABASE_URL=postgresql+psycopg://automato:automato@localhost:5432/automato
AUTOMATO_REDIS_URL=redis://localhost:6379/0
AUTOMATO_ORCHESTRATOR_URL=http://localhost:8000
# Service-Token Collector -> Orchestrator (interne API). In echten Umgebungen
# einen langen Zufallswert setzen, z. B.: openssl rand -hex 32
AUTOMATO_INTERNAL_API_TOKEN=dev-only-token
# Schluessel fuer die Geraete-Zugangsdaten (API-Tokens der Quellsysteme, ADR 0009).
# Leer = Schluesseldatei /var/lib/automato/credentials.key (Volume orchestrator-data, wird
# beim ersten Start erzeugt - mitsichern!). Alternativ eine lange Passphrase oder eine
# Secret-Referenz (openbao:/file:/env:). Wechsel/Verlust = Tokens im Web-UI neu hinterlegen.
# AUTOMATO_CREDENTIALS_KEY=
# Oberflaeche (1.0.0): Vorgabe ist der Produktions-Build (statische Dateien hinter Caddy).
# Im Labor optional der Vite-Server - dann auch das Dateisystem beschreibbar lassen:
# AUTOMATO_UI_TARGET=dev
# AUTOMATO_UI_READ_ONLY=false

# Front-Proxy (1.2.0, ADR 0044 Nachtrag; Profil "proxy", deploy/front/front.sh,
# docs/INSTALLATION-FRONT.md): Startseiten <kunde>.<DOMAIN>, Weiterleitung <kunde>-nb/-doc/-um/-cmdb,
# Portal start.<DOMAIN_INT>. Zertifikate deploy/proxy/pki/mgmt.crt|key und mgmt-int.crt|key.
# AUTOMATO_FRONT_DOMAIN=mgmt.example.ch
# AUTOMATO_FRONT_DOMAIN_INT=mgmt.int.example.ch
# AUTOMATO_FRONT_WAF=10.0.40.1/32          # nur ihr wird X-Forwarded-For geglaubt
# AUTOMATO_FRONT_MGMT=10.0.10.0/24         # Management-Netz (interne Adressen, Tests)
# AUTOMATO_FRONT_KUNDEN_ALLOW=             # Kunden-Adressen; leer = WAF + Management-Netz
#   FortiGate mit VIP (Adresse des Besuchers statt WAF): "0.0.0.0/0 ::/0" und AUTOMATO_UI_ALLOW setzen
# AUTOMATO_FRONT_NETBOX=10.0.30.20         # NetBox-Host (Name oder IP, optional :Port)
# AUTOMATO_FRONT_NETBOX_CA=                # leer = öffentliches Zertifikat; sonst CA-Datei in deploy/proxy/pki
# AUTOMATO_FRONT_MAGISTER=                 # z. B. https://magister.int.example.ch (leer = -um aus)
# AUTOMATO_FRONT_CMDB=                     # später (leer = -cmdb aus)
# Anmelde-Tor (1.4.0, ADR 0051): vor jeder Kunden-Adresse und dem Portal zuerst die Anmeldung im
# Realm des Kunden (oauth2-proxy je Realm, Client automato-front, Secret: front.sh tor <realm>)
# AUTOMATO_FRONT_TOR=an                    # an | aus (Vorgabe aus); Kunden ohne Realm sind dann gesperrt
# AUTOMATO_FRONT_KEYCLOAK=                 # Keycloak für den Browser; leer = aus AUTOMATO_OIDC_ISSUER
# AUTOMATO_FRONT_KEYCLOAK_INTERN=          # Keycloak für den Proxy (Token, Schlüssel); leer = aus AUTOMATO_OIDC_JWKS_URL
# AUTOMATO_FRONT_KEYCLOAK_CA=              # CA-Datei in deploy/proxy/pki, wenn Keycloak ein Zertifikat der eigenen CA hat
# AUTOMATO_FRONT_INTERN_ROLLEN=admin operator   # Portal start.<intern> nur für diese Rollen
# AUTOMATO_FRONT_TOR_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:v7.15.6

# Erlaubte CORS-Origins fuers Web-UI (JSON-Liste). In Produktion explizit setzen.
AUTOMATO_CORS_ORIGINS=["http://localhost:5173"]
# Aufbewahrung (0.48.0): beendete Laeufe, alte NetBox-Sync-Vorschauen und Audit-Eintraege nach
# so vielen Tagen loeschen (0 = nie); der aktuelle Stand bleibt immer
# AUTOMATO_RETENTION_RUNS_DAYS=90
# AUTOMATO_RETENTION_SYNC_DAYS=90
# AUTOMATO_RETENTION_AUDIT_DAYS=365
# MAC-/ARP-Eintraege der Switches (0.63.0), die so lange kein Lauf mehr gesehen hat
# AUTOMATO_RETENTION_L2_DAYS=30
# Datenqualitaet (0.91.0): Stand eines Quellsystems nach so vielen Tagen ohne erfolgreichen Lauf
# veraltet (Befund source_stale, Betriebszustand; mit Zeitplan mindestens Abstand + 1 Tag; 0 = nie)
# AUTOMATO_STALE_DAYS=7
# Verlauf des Routings (ADR 0030): Aenderungen an Routen, BGP-Nachbarn, HA ... nach so vielen Tagen
# AUTOMATO_RETENTION_TOPO_CHANGES_DAYS=180
# Abweichung Regel <-> Weg der Applikationen (0.59.0): hoechstens so viele Sekunden je
# Neuberechnung nach einem Lauf (0 = ohne Grenze); der Rest kommt beim naechsten Lauf dran
# AUTOMATO_APP_FINDINGS_SECONDS=120
# Wege je Applikation (0.130.0): Verbindungen/Netzwerkplan bzw. Befunde, 0 = alle
# AUTOMATO_APP_TRACES_MAX=2000
# AUTOMATO_APP_FINDINGS_TRACES=120
# Wege je Mandant im Speicher (0.140.0, ADR 0048): so viele MB, darueber fallen die aeltesten
# weg und werden bei Bedarf neu gerechnet (Speicher, nicht Pruefung)
# AUTOMATO_PATH_STORE_MB=256
# Verbindungen zur Datenbank und Threads fuer Anfragen (0.80.1); die Summe der Verbindungen
# (Pool + Ueberlauf, dazu Celery-Worker) unter max_connections von Postgres halten
# AUTOMATO_DB_POOL_SIZE=10
# AUTOMATO_DB_MAX_OVERFLOW=20
# AUTOMATO_API_THREADS=80
# Die oeffentliche Read-API hat noch kein AuthN/RBAC. Ausserhalb "dev" verweigert der
# Start, bis dies bewusst gesetzt ist (nur mit Netzsegmentierung/Proxy-Auth davor).
AUTOMATO_ALLOW_UNAUTHENTICATED_READ_API=false

# --- AuthN/RBAC (E1, ADR 0007) ----------------------------------------------
# dev: Standard-Admin-Principal (unveraendertes Verhalten), Override zum Testen via
# Header X-Dev-Roles / X-Dev-Tenants. oidc: JWT gegen Keycloak (naechster Schritt E1.1b).
# Rollen: viewer|operator|admin; Mandanten-Scoping wird serverseitig erzwungen.
AUTOMATO_AUTH_MODE=dev
# AUTOMATO_OIDC_ISSUER=
# AUTOMATO_OIDC_AUDIENCE=
# AUTOMATO_OIDC_JWKS_URL=
# AUTOMATO_OIDC_ROLES_CLAIM=realm_access.roles
# AUTOMATO_OIDC_TENANTS_CLAIM=tenant_ids
# AUTOMATO_OIDC_CUSTOMERS_CLAIM=customer_ids   # Kunden-Benutzer (ADR 0018)
# AUTOMATO_OIDC_CUSTOMER_ROLE_CLAIM=customer_role   # Kunden-Rolle viewer|triage|editor|customer_admin

# --- NetBox global (nur Labor, Rueckfall) -------------------------------------
# Normalfall: NetBox je Mandant als Referenzquelle im Web-UI (Quellsysteme), im Betrieb
# https://<kunde>-nb.<domain> (docs/INSTALLATION-FRONT.md). Diese Werte gelten nur, solange ein
# NetBox-Mandant noch keinen eingelesenen Stand hat - im Betrieb leer lassen bzw. weglassen.
# Labor: NetBox als eigener Stack auf dem Host (source-of-truth/netbox/setup.sh, Port 8080).
# AUTOMATO_NETBOX_URL=http://host.docker.internal:8080
# AUTOMATO_NETBOX_TOKEN=
AUTOMATO_NETBOX_VERIFY_TLS=true

# --- Zielsysteme lokal (nur Rueckfall, read-only Accounts!) ------------------
# Normalfall: Adresse + Zugangsdaten am Quellsystem im Web-UI (ADR 0009). Diese Werte
# nutzt nur der zentrale Worker, wenn am Geraet nichts hinterlegt ist; beides leer ->
# Beispieldaten (Fixtures). verify_tls im Lab meist false (selbstsigniert).
AUTOMATO_FORTIGATE_URL=
AUTOMATO_FORTIGATE_TOKEN=
AUTOMATO_FORTIGATE_VERIFY_TLS=false
# Cisco APIC (Benutzer mit Nur-Lese-Rolle); ACI_TENANTS kommagetrennt, leer = alle
# ausser infra/mgmt
# AUTOMATO_ACI_URL=
# AUTOMATO_ACI_USERNAME=
# AUTOMATO_ACI_PASSWORD=
# AUTOMATO_ACI_VERIFY_TLS=false
# AUTOMATO_ACI_TENANTS=

# --- Weitere Zielsysteme (spaetere Phasen) -----------------------------------
# AUTOMATO_INFOBLOX_URL=
# AUTOMATO_INFOBLOX_USERNAME=
# AUTOMATO_INFOBLOX_PASSWORD=
