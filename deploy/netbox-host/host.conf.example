# Einstellungen des NetBox-Hosts (netbox-host.sh) – liegt als /opt/netbox-host/host.conf (0600).

# Domain der Adressen: NetBox des Kunden = <kunde>-nb.<DOMAIN>. Startseite (<kunde>.<DOMAIN>),
# Automato (<kunde>-doc), Benutzerverwaltung (<kunde>-um) und CMDB (<kunde>-cmdb) liegen auf dem
# Front-Proxy der Automato-VM (ADR 0044 Nachtrag). Zertifikat für *.<DOMAIN> in
# proxy/pki/wildcard.crt|key – hier genügt eines der eigenen CA (der Front-Proxy prüft gegen sie).
DOMAIN=mgmt.example.ch

# Wer diesen Host erreichen darf (mit Leerzeichen getrennt): der Front-Proxy (Automato-VM) und das
# Management-Netz. Kunden kommen nur über den Front-Proxy, nie direkt.
ALLOW="10.0.30.5/32 10.0.10.0/24"

# Front-Proxy (Automato-VM): nur seiner Angabe X-Forwarded-For wird geglaubt – NetBox sieht so die
# Adresse des Benutzers statt die des Front-Proxys (leer = nicht übernehmen)
FRONT="10.0.30.5/32"

# Port des Proxys auf dieser VM (1.9.1). 443, ausser hier läuft schon ein Dienst auf 443 (z. B. in
# Dev auf der Magister-VM): dann z. B. 8444, in .env des Front-Proxys AUTOMATO_FRONT_NETBOX=<ip>:8444
# und die Firewall für diesen Port öffnen. Nach einer Änderung: netbox-host.sh init
# PORT=443

# Anmeldung über das Anmelde-Tor des Front-Proxys (1.4.0, ADR 0051): NetBox übernimmt den Benutzer
# aus den Kopfzeilen des Front-Proxys (nur von FRONT); Rechte aus den Realm-Rollen (role:admin =
# Superuser, role:operator = bearbeiten, sonst lesen). Einrichten bzw. nachführen: sso alle
SSO=an

# Agent (1.11.0, ADR 0054): legt die NetBox je Kunde selbst an – aus den Kunden mit dem Werkzeug
# NetBox in Automato. Einrichten: netbox-host.sh agent https://<oberfläche von automato> (setzt
# AUTOMATO_URL, das Token liegt in automato.token, nur root). AUTOMATO_CA: CA des Zertifikats der
# Oberfläche, wenn sie nicht im System hinterlegt ist (PEM, z. B. /opt/netbox-host/automato-ca.pem).
# AUTOMATO_URL=
# AUTOMATO_CA=

# Version: netbox-docker-Tag und passendes Image (gleich wie source-of-truth/netbox/setup.sh)
NETBOX_DOCKER_TAG=5.0.2
NETBOX_VERSION=v4.6.10-5.0.2

TIME_ZONE=Europe/Zurich

# Sicherung (täglich per cron, verschlüsselt mit age; init legt den Schlüssel an). "sichern alle"
# sichert je Kunde Datenbank und Medien und dazu die Konfiguration (host.conf, Zertifikat, Secrets).
BACKUP_DIR=/var/backups/netbox-host
BACKUP_KEEP_DAYS=14
