# Proxy des NetBox-Hosts (netbox-host.sh, ADR 0044). Je Kunde ein Eintrag in sites/:
#   <kunde>-nb.<domain>  NetBox des Kunden (Container nb-<kunde> im Netz netbox-front)
# Seit 1.1.0 ein Backend: Kunden kommen über den Front-Proxy der Automato-VM (Startseiten,
# Portal, WAF davor). ALLOW (.env aus host.conf): Front-Proxy und Management-Netz.
# FRONT: dem Front-Proxy wird X-Forwarded-For geglaubt (Adresse des Benutzers im Protokoll).
{
	servers {
		protocols h1 h2
		trusted_proxies static {$FRONT:127.0.0.1/32}
	}
}

(common) {
	tls /etc/caddy/pki/wildcard.crt /etc/caddy/pki/wildcard.key {
		protocols tls1.2 tls1.3
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
	# Nur aus freigegebenen Netzen (direkte Gegenstelle, nicht X-Forwarded-For); Docker muss die
	# Quell-IP erhalten ("userland-proxy": false)
	@blocked not remote_ip {$ALLOW}
	respond @blocked "Zugriff nur aus freigegebenen Netzen" 403
}

import /etc/caddy/sites/*.caddy
