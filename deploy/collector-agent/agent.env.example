# Automato Collector-Agent - Beispielkonfiguration (ADR 0008/0009).
# Kopie nach agent.env, Platzhalter ersetzen. NICHT committen (Secrets).
# Format: KEY=VALUE, eine Zeile pro Wert, keine Anfuehrungszeichen.
#
# Die Geraete (FortiGate, Cisco APIC) und ihre Zugangsdaten (Token bzw. Benutzer/Passwort)
# werden NICHT hier erfasst, sondern im Web-UI unter "Mandanten & Standorte" -> Quellsystem
# und dort diesem Agenten zugewiesen. Der Agent erhaelt sie pro Lauf vom Orchestrator
# (ADR 0009). Geraete lassen sich so spaeter einem anderen Agenten zuweisen, ohne hier etwas
# zu aendern.

# --- Orchestrator ---
# Agent spricht die /internal-API direkt am Orchestrator an (nicht ueber den Web-UI-Proxy,
# der /internal bewusst nicht ausliefert). Dev/Lab z. B. http://172.25.12.12:8000,
# produktiv https://... mit TLS (siehe unten).
AUTOMATO_ORCHESTRATOR_URL=http://<orchestrator-host>:8000
# Agent-Token: im Web-UI unter "Collector-Agenten" anlegen (wird nur einmal angezeigt).
# Damit holt der Agent Laeufe ab und liefert die Ergebnisse ab - ein internes Token
# braucht er nicht.
AUTOMATO_AGENT_TOKEN=<AGENT_TOKEN>

# --- TLS zum Orchestrator (produktiv: mTLS-Agent-Gateway, deploy/agent-gateway) ---
# Produktiv zeigt AUTOMATO_ORCHESTRATOR_URL auf das Gateway (https://<host>:8443) und der
# Agent praesentiert sein Client-Zertifikat (CN = Agent-Name, make-certs.sh agent <name>).
# Nur einkommentieren, wenn die Dateien wirklich existieren - sonst startet der Agent nicht.
# AUTOMATO_ORCHESTRATOR_CA_BUNDLE=C:\Automato\pki\agents-ca.crt
# AUTOMATO_CLIENT_CERT=C:\Automato\pki\agent-<name>.crt
# AUTOMATO_CLIENT_KEY=C:\Automato\pki\agent-<name>.key

# --- Signierte Updates (produktiv empfohlen) ---
# Oeffentlicher Schluessel (scripts/agent_signing.py keygen): gesetzt = der Agent installiert
# nur Updates mit gueltiger Signatur und bleibt sonst bei seiner Version.
# AUTOMATO_AGENT_SIGNING_PUBKEY=<Base64>
