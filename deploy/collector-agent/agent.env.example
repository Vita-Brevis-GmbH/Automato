# Automato Collector-Agent - Beispielkonfiguration (ADR 0008).
# Kopie nach agent.env, Platzhalter ersetzen. NICHT committen (Secrets).

# Orchestrator (intern erreichbar)
AUTOMATO_ORCHESTRATOR_URL=https://orchestrator.intern
AUTOMATO_AGENT_TOKEN=<AGENT_TOKEN aus POST /agents>

# TLS (empfohlen): Server-CA pinnen + mTLS-Client-Zertifikat
AUTOMATO_ORCHESTRATOR_CA_BUNDLE=C:\Automato\pki\orch-ca.pem
AUTOMATO_CLIENT_CERT=C:\Automato\pki\agent.crt
AUTOMATO_CLIENT_KEY=C:\Automato\pki\agent.key

# Zielsystem FortiGate (read-only!)
AUTOMATO_FORTIGATE_URL=https://fw.kunde.intern
AUTOMATO_FORTIGATE_TOKEN=<FORTIGATE_READONLY_TOKEN>
AUTOMATO_FORTIGATE_VERIFY_TLS=true

# Cisco APIC (read-only) - Phase 2
# AUTOMATO_APIC_URL=https://apic.kunde.intern
# AUTOMATO_APIC_USERNAME=<ro-user>
# AUTOMATO_APIC_PASSWORD=<pw>
